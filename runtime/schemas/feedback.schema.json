{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somner:librarian:feedback:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "rating": {
      "enum": [
        "useful",
        "wrong",
        "missing_evidence",
        "needs_research"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "interaction_id",
    "rating"
  ]
}
