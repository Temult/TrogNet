{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somner:librarian:public-answer:integration-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "answer_class": {
      "enum": [
        "evidence_summary",
        "conditional",
        "unknown"
      ]
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E(?:[1-9]|[1-5][0-9]|6[0-4])$"
            },
            "maxItems": 16
          }
        },
        "required": [
          "text",
          "citations"
        ]
      },
      "maxItems": 8
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E(?:[1-9]|[1-5][0-9]|6[0-4])$"
          },
          "title": {
            "type": "string",
            "maxLength": 4000
          },
          "excerpt": {
            "type": "string",
            "maxLength": 2500
          },
          "status": {
            "type": "string",
            "maxLength": 4000
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4000
            },
            "maxItems": 40
          },
          "class": {
            "enum": [
              "SOURCE",
              "DERIVED",
              "MODEL",
              "OBSERVED",
              "OPEN"
            ]
          },
          "snapshot": {
            "type": "string",
            "maxLength": 4000
          },
          "scope": {
            "type": "string",
            "maxLength": 30000
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30000
            },
            "maxItems": 128
          },
          "formula": {
            "type": "string",
            "maxLength": 30000
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 128
          },
          "inputs_note": {
            "type": "string",
            "maxLength": 4000
          },
          "environment": {
            "type": "object"
          },
          "open_boundary": {
            "type": "object"
          },
          "context_role": {
            "enum": [
              "primary",
              "required"
            ]
          },
          "card_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "publication_card": {
            "oneOf": [
              {
                "$ref": "#/$defs/public_v12_card"
              },
              {
                "$ref": "#/$defs/legacy_rc1_card"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "excerpt",
          "status",
          "assumptions"
        ]
      },
      "maxItems": 64
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "maxItems": 332
    },
    "research_recorded": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "Markdown",
              "JSON"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/api/answers/[0-9a-f-]{36}/file\\?format=(md|json)$"
          }
        },
        "required": [
          "label",
          "path"
        ]
      },
      "maxItems": 2
    },
    "evidence_release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "legacy",
            "rc1",
            "publication-v1.2-strict"
          ]
        },
        "producer_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer_corpus_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "public_cards_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "requested_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "enum": [
            "candidate_only",
            "tester_approved"
          ]
        },
        "scope_notice": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "release_id",
        "profile",
        "producer_release",
        "producer_corpus_sha256",
        "public_cards_sha256",
        "requested_snapshot",
        "publication",
        "scope_notice"
      ]
    },
    "evidence_status": {
      "enum": [
        "OK",
        "NO_SUPPORTED_EVIDENCE",
        "EVIDENCE_BUDGET_EXCEEDED",
        "SNAPSHOT_SCOPE_CONFLICT"
      ]
    }
  },
  "required": [
    "interaction_id",
    "answer_class",
    "paragraphs",
    "citations",
    "caveats",
    "research_recorded",
    "files"
  ],
  "$defs": {
    "public_v12_card": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "DERIVED"
              }
            }
          },
          "then": {
            "required": [
              "inputs",
              "formula"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "MODEL"
              }
            }
          },
          "then": {
            "properties": {
              "assumptions": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "assumptions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "OBSERVED"
              }
            }
          },
          "then": {
            "required": [
              "environment"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "required": [
              "open_boundary"
            ]
          }
        }
      ],
      "properties": {
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "card_id": {
          "minLength": 1,
          "type": "string"
        },
        "class": {
          "enum": [
            "SOURCE",
            "DERIVED",
            "MODEL",
            "OBSERVED",
            "OPEN"
          ]
        },
        "entities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "properties": {
            "conditions": {
              "minLength": 1,
              "type": "string"
            },
            "observation_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "conditions",
            "observation_id"
          ],
          "type": "object"
        },
        "formula": {
          "minLength": 1,
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer_release"
          ],
          "properties": {
            "producer_release": {
              "const": "echoes-publication/v1.2.0-candidate"
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "result": {},
            "transformation_operation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "open_boundary": {
          "properties": {
            "closes_with": {
              "minLength": 1,
              "type": "string"
            },
            "question": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "question",
            "closes_with"
          ],
          "type": "object"
        },
        "publication": {
          "const": "candidate_only"
        },
        "required_cards": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "schema": {
          "const": "echoes-publication-card/v1"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "snapshot": {
          "minLength": 1,
          "type": "string"
        },
        "source_artifact": {
          "minLength": 1,
          "type": "string",
          "pattern": "^publication-corpus-sha256:[a-f0-9]{64}$"
        },
        "source_refs": {
          "items": {
            "minLength": 1,
            "type": "string",
            "pattern": "^publication-source:[a-f0-9]{64}$"
          },
          "minItems": 1,
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "superseded_by": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "supersedes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "topics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "card_id",
        "class",
        "title",
        "statement",
        "snapshot",
        "scope",
        "entities",
        "topics",
        "source_refs",
        "source_artifact",
        "limitations",
        "publication",
        "required_cards",
        "superseded_by",
        "supersedes",
        "legacy"
      ],
      "type": "object"
    },
    "legacy_rc1_card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "minLength": 1,
          "type": "string"
        },
        "class": {
          "enum": [
            "SOURCE",
            "DERIVED",
            "MODEL",
            "OBSERVED",
            "OPEN"
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "snapshot": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "formula": {
          "minLength": 1,
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "environment": {
          "properties": {
            "conditions": {
              "minLength": 1,
              "type": "string"
            },
            "observation_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "conditions",
            "observation_id"
          ],
          "type": "object"
        },
        "open_boundary": {
          "properties": {
            "closes_with": {
              "minLength": 1,
              "type": "string"
            },
            "question": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "question",
            "closes_with"
          ],
          "type": "object"
        },
        "superseded_by": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "inputs_note": {
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "class",
        "title",
        "statement",
        "snapshot",
        "scope",
        "limitations"
      ]
    }
  }
}
