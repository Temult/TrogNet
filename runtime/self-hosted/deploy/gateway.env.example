# Candidate only. Root-owned /etc/trognet-gateway/gateway.env mode 0600.
# Credential files and their leaf directory must be trognet-owned 0600/0700.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=19456
GATEWAY_STATE_DIR=/var/lib/trognet-gateway
GATEWAY_RUN_DIR=/run/trognet-gateway
GATEWAY_HOST_ID_FILE=/etc/trognet-gateway/secrets/host-id
GATEWAY_KEY_FILE=/etc/trognet-gateway/secrets/credential-key
GATEWAY_ADMISSION_FILE=/etc/trognet-gateway/secrets/origin-admission
GATEWAY_OWNER_FILE=/etc/trognet-gateway/secrets/owner-admission
